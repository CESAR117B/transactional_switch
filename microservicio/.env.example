# Plantilla de variables del microservicio.
#
# Uso local:
#   cp .env.example .env   (y ajustar los valores)
#
# En Docker: docker-compose carga primero este archivo y luego `.env` si
# existe, así que un `.env` real (repartido por otro medio) siempre gana.

# Conexión a PostgreSQL.
# - Dentro de la red Docker: host `postgres`, puerto 5432.
# - Desde el host (DBeaver, etc.): localhost:55432
DATABASE_URL="postgresql://root:1234@postgres:5432/switch?schema=public"

# Interfaz donde escucha el microservicio (TCP).
# El compose fuerza 0.0.0.0 dentro del contenedor.
HOST=0.0.0.0
PORT=3001

# Secreto compartido con client-app. Debe ser EXACTAMENTE el mismo valor en
# ambos `.env`, porque con él se valida el sobre de cada llamada RPC.
MICROSERVICE_SECRET=cambiar-por-un-secreto-compartido
