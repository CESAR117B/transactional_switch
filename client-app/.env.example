# Copia este archivo a .env y completa los valores.
# Los cambios se leen al ARRANCAR la app (no hay recarga en caliente).

# --- Infraestructura ---
MICROSERVICE_HOST=127.0.0.1
MICROSERVICE_PORT=3001
PORT=3000

# Obligatorio: sin esta variable la app NO arranca. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Rate limit (ver src/throttler.config.ts) ---
# Valor inválido (texto, decimal, negativo) => warning en log + default.
# Un valor 0 bloquea todo el tráfico de ese tipo.

# Peticiones por minuto por App autenticada (bucket global compartido por
# TODOS los endpoints; cabeceras X-RateLimit-*-app).
RATE_LIMIT_APP_MAX=10
RATE_LIMIT_APP_VENTANA_SEG=60

# Peticiones por minuto por IP para el resto de rutas (sin autenticar).
# /auth/login usa además RATE_LIMIT_LOGIN_MAX.
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_IP_VENTANA_SEG=60

# Intentos de login por minuto por IP.
RATE_LIMIT_LOGIN_MAX=5
