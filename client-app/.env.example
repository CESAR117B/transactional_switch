# Plantilla de variables del API Gateway (client-app).
#
# Uso local:
#   cp .env.example .env   (y ajustar los valores)
#
# En Docker: docker-compose carga primero este archivo y luego `.env` si
# existe, así que un `.env` real (repartido por otro medio) siempre gana.

# Dirección del microservicio.
# - Dentro de la red Docker: `microservicio` (nombre del servicio).
# - En local sin Docker: 127.0.0.1
MICROSERVICE_HOST=microservicio
MICROSERVICE_PORT=3001

# Tiempo máximo (ms) por llamada al microservicio antes de devolver 503.
MICROSERVICE_TIMEOUT_MS=5000

PORT=3000

# --- Rate limit (src/throttler.config.ts) ---
# Peticiones por minuto por App autenticada (bucket global, todos los endpoints).
RATE_LIMIT_APP_MAX=10
RATE_LIMIT_APP_VENTANA_SEG=60
# Peticiones por minuto por IP para el resto de rutas.
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_IP_VENTANA_SEG=60
# Intentos de login por minuto por IP.
RATE_LIMIT_LOGIN_MAX=5

# Secreto para firmar los JWT emitidos por el gateway.
JWT_SECRET=cambiar-por-un-secreto-propio

# Secreto compartido con el microservicio. Debe ser EXACTAMENTE el mismo valor
# en ambos `.env`.
MICROSERVICE_SECRET=cambiar-por-un-secreto-compartido
